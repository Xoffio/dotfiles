# This is so nvim clipboard works
set-option -g set-clipboard on
set-option -g allow-passthrough on

# List of plugins
# To install press <leader>-I
set -g @plugin 'tmux-plugins/tpm'
set -g @plugin 'christoomey/vim-tmux-navigator'
set -g @plugin 'wfxr/tmux-power'

{{ if stat "/maker" -}}
set -g @tmux_power_theme 'violet'
{{ else -}}
set -g @tmux_power_theme '#FFDA03'
{{ end }}

# Truecolor passthrough
set -ag terminal-overrides ",*:RGB"

# Enable vi-like selection mode
# You can do `prefix+[`, then "Visual" mode with `V`, and yank lines with `y`
set -g mode-keys vi
bind-key -T copy-mode-vi v send -X begin-selection
bind-key -T copy-mode-vi V send -X select-line
bind-key -T copy-mode-vi y send-keys -X copy-selection-and-cancel

# Split panes with the current path
bind '"' split-window -c "#{pane_current_path}"
bind % split-window -h -c "#{pane_current_path}"

# Custom key bindings menu
bind Space display-menu \
  -T "#[align=centre,fg=#89b4fa,bold]-󰚌-" \
  -x C -y C \
  -b rounded \
  -s "bg=#1e1e2e,fg=#cdd6f4" \
  -S "fg=#89b4fa" \
  -H "bg=#89b4fa,fg=#1e1e2e,bold" \
  " New Window"         n "new-window" \
  " Split Horizontal"   h "split-window -h" \
  " Split Vertical"     v "split-window -v" \
  "󰧻 Kill Pane"          x "kill-pane" \
  "󰑓 Reload Config"      r "source-file ~/.tmux.conf" \
  "" \
  "󰚩 Workmux Add"           a "display-popup -EE -d '#{pane_current_path}' -w 60 -h 3 -b rounded -s 'bg=#1e1e2e,fg=#cdd6f4' -S 'fg=#89b4fa' -T ' workmux add ' '~/.config/tmux/workmux-add.sh plain'" \
  "󰚩 Workmux Add + Prompt"  p "display-popup -EE -d '#{pane_current_path}' -w 80 -h 4 -b rounded -s 'bg=#1e1e2e,fg=#cdd6f4' -S 'fg=#89b4fa' -T ' workmux add --prompt ' '~/.config/tmux/workmux-add.sh prompt'" \
  "󰚩 Workmux Add + Editor"  e "display-popup -EE -d '#{pane_current_path}' -w 80% -h 80% -b rounded -s 'bg=#1e1e2e,fg=#cdd6f4' -S 'fg=#89b4fa' -T ' workmux add --prompt-editor ' '~/.config/tmux/workmux-add.sh editor'" \
  "󰕮 Workmux Dashboard"  d "display-popup -E -w 90% -h 90% 'workmux dashboard'" \
  " Workmux Sidebar"    s "run-shell 'workmux sidebar'" \
  "" \
  "󱘖 Detach Session"     D "detach-client"

{{ if lookPath "fish" }}
# Set default shell to fish
set -g default-shell {{ lookPath "fish" }}
{{ end }}

# This needs to be the last line
run '~/.tmux/plugins/tpm/tpm'
